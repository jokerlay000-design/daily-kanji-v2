<h1>Share your sighting of <%= @kanji.character %></h1>

<%= form_with model: [@kanji, @post] do |f| %>
  <div>
    <%= f.label :image, "Photo" %><br />
    <%= f.file_field :image %>
  </div>

  <div>
    <%= f.label :caption, "Caption" %><br />
    <%= f.text_area :caption, placeholder: "Where did you see it?", rows: 3 %>
  </div>

  <div>
    <%= f.submit "Post sighting" %>
  </div>
<% end %>

<%= link_to "Back", kanji_path(@kanji) %>